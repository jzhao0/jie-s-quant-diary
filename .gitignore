# =============================================================================
# Python 量化项目 .gitignore
# =============================================================================

# 数据文件 (不提交到Git)
data/
*.csv
*.pkl
*.h5
*.parquet
*.db
*.sqlite

# Jupyter Notebook
checkpoints/
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 环境配置 (包含敏感信息)
.env
config.ini
secrets.yaml

# 日志
*.log
logs/

# 量化特定
backtest_results/
trades/
